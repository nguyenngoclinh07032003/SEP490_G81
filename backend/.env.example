# Môi trường chạy hệ thống (development | production)
NODE_ENV=development
PORT=5000

# Cấu hình Cơ sở dữ liệu PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hrmss

# Cấu hình Caching & Session Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://default:<password>@<host>:<port>

# Cấu hình Express-Session Cookie
SESSION_SECRET=HRMSS_SESSION_SECRET_KEY_FOR_SEP490_G81_CAPSTONE_2026

# Cấu hình JWT Token (Chuẩn RFC 7519)
JWT_SECRET=HRMSS_SECRET_KEY_FOR_SEP490_G81_CAPSTONE_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=hrmss.minhduc.vn
JWT_AUDIENCE=hrmss-client

# Cấu hình CORS Frontend
CORS_ORIGIN=http://localhost:5173
